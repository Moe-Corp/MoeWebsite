    <Footer />
  </main>
</Layout>

<style>
  @keyframes flow-line {
    0% { stroke-dashoffset: 24; }
    100% { stroke-dashoffset: 0; }
  }
  @keyframes cursor-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
  @keyframes live-pulse {
    0% { transform: scale(0.95); opacity: 0.8; box-shadow: 0 0 0 0 rgba(255, 231, 0, 0.7); }
    70% { transform: scale(1.1); opacity: 1; box-shadow: 0 0 0 6px rgba(255, 231, 0, 0); }
    100% { transform: scale(0.95); opacity: 0.8; box-shadow: 0 0 0 0 rgba(255, 231, 0, 0); }
  }
  @keyframes flow-bg {
    0% { background-position: 0 0; }
    100% { background-position: 40px 0; }
  }
  @keyframes log-fade-in {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .anim-terminal-cursor {
    display: inline-block;
    width: 7px;
    height: 13px;
    background-color: #ffe700;
    vertical-align: middle;
    animation: cursor-blink 1s steps(2, start) infinite;
  }
  .anim-live-dot {
    animation: live-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  .pipeline-dash-flow {
    stroke-dasharray: 4, 4;
    animation: flow-line 1.2s linear infinite;
  }
  .kinetic-speed-lines {
    animation: flow-bg 8s linear infinite;
  }
  .technical-card-hover {
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .technical-card-hover:hover {
    transform: translateX(2px);
    border-color: #2d2a29;
    box-shadow: -2px 0 0 #ffe700;
  }
  .table-row-hover {
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .table-row-hover:hover {
    transform: translateX(2px);
  }
  .new-log-entry {
    animation: log-fade-in 0.35s ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    .anim-terminal-cursor,
    .anim-live-dot,
    .pipeline-dash-flow,
    .kinetic-speed-lines,
    .technical-card-hover,
    .technical-card-hover:hover,
    .table-row-hover,
    .table-row-hover:hover,
    .new-log-entry {
      animation: none !important;
      transition: none !important;
      transform: none !important;
      box-shadow: none !important;
    }
  }
</style>

<script is:inline>
  const traces = [
    { type: "app.crashed", app: "checkout-api", runtime: "node@22.3.0", release: "1.4.2", pid: 48211, signal: "SIGKILL", heartbeat: 1840, fingerprint: "a7f3c901" },
    { type: "app.fatal", app: "auth-service", runtime: "node@22.3.0", release: "2.1.0", pid: 39120, signal: "SIGABRT", heartbeat: 410, fingerprint: "c8e2194b" },
    { type: "app.blocked", app: "worker-queue", runtime: "bun@1.1.20", release: "1.0.8", pid: 51094, signal: "EVENT_LOOP_STALL", heartbeat: 6240, fingerprint: "e102f98a" },
    { type: "app.recovered", app: "worker-queue", runtime: "bun@1.1.20", release: "1.0.8", pid: 51094, signal: "STALL_CLEARED", heartbeat: 24, fingerprint: "e102f98a" }
  ];

  let traceIndex = 0;

  function formatTimestamp() {
    const d = new Date();
    const pad = (n) => String(n).padStart(2, "0");
    return `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
  }

  function renderTrace(trace) {
    const container = document.getElementById("ndjson-trace");
    const badge = document.getElementById("terminal-badge");
    if (!container || !badge) return;

    badge.textContent = `sidecar · alert emitted ${formatTimestamp()}`;
    container.className = "new-log-entry";

    container.innerHTML = `
      <div>{<span class="text-[#187384]">"type"</span>:<span class="text-[#FFE700]">"${trace.type}"</span>,<span class="text-[#187384]">"app"</span>:<span class="text-[#cbc5c3]">"${trace.app}"</span>,</div>
      <div class="pl-2"><span class="text-[#187384]">"runtime"</span>:<span class="text-[#cbc5c3]">"${trace.runtime}"</span>,<span class="text-[#187384]">"release"</span>:<span class="text-[#cbc5c3]">"${trace.release}"</span>,</div>
      <div class="pl-2"><span class="text-[#187384]">"pid"</span>:<span class="text-[#cbc5c3]">${trace.pid}</span>,<span class="text-[#187384]">"signal"</span>:<span class="text-[#FFE700]">"${trace.signal}"</span>,</div>
      <div class="pl-2"><span class="text-[#187384]">"last_heartbeat_ms_ago"</span>:<span class="text-[#cbc5c3]">${trace.heartbeat}</span>,</div>
      <div class="pl-2"><span class="text-[#187384]">"fingerprint"</span>:<span class="text-[#187384]">"${trace.fingerprint}"</span>}</div>
    `;

    setTimeout(() => {
      container.classList.remove("new-log-entry");
    }, 400);
  }

  function cycleTraceLog() {
    traceIndex = (traceIndex + 1) % traces.length;
    renderTrace(traces[traceIndex]);
  }

  function setTerminalTrace(type, app, signal, heartbeat) {
    const customTrace = {
      type,
      app,
      runtime: "node@22.3.0",
      release: "1.4.2",
      pid: Math.floor(10000 + Math.random() * 89999),
      signal,
      heartbeat,
      fingerprint: Math.random().toString(16).substring(2, 10)
    };
    renderTrace(customTrace);

    const term = document.getElementById("terminal-badge");
    if (term && window.scrollY > 500) {
      term.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  }

  const runtimeCommands = {
    node: { cmd: "npm i @moecorp/moelog-node @moecorp/moelog-sidecar", size: "0.95 kB core" },
    bun: { cmd: "bun add @moecorp/moelog-bun @moecorp/moelog-sidecar", size: "1.3 kB core" },
    deno: { cmd: "deno add npm:@moecorp/moelog-core", size: "1.5 kB core" },
    browser: { cmd: "npm i @moecorp/moelog-browser", size: "≤ 3 kB core" },
    edge: { cmd: "npm i @moecorp/moelog-edge", size: "≤ 2 kB core" }
  };

  let activeRuntime = "node";

  function selectRuntime(runtime, btn) {
    activeRuntime = runtime;
    const container = document.getElementById("install-runtime-tabs");
    if (container) {
      const buttons = container.querySelectorAll("button");
      buttons.forEach((b) => {
        b.className = "hover:text-white pb-1";
      });
    }
    btn.className = "text-[#FFE700] border-b-2 border-[#FFE700] pb-1 font-bold";

    const info = runtimeCommands[runtime] || runtimeCommands.node;
    const cmdSpan = document.getElementById("install-command");
    if (cmdSpan) {
      cmdSpan.innerHTML = `<span class="text-[#FFE700]">$</span> ${info.cmd}`;
      const nextBadge = cmdSpan.nextElementSibling;
      if (nextBadge) nextBadge.textContent = info.size;
    }
  }

  function copyInstallCmd() {
    const current = runtimeCommands[activeRuntime] || runtimeCommands.node;
    navigator.clipboard.writeText(current.cmd).then(() => {
      const btn = document.getElementById("copy-btn");
      const icon = document.getElementById("copy-icon");
      const label = document.getElementById("copy-label");

      if (btn && icon && label) {
        icon.textContent = "check";
        label.textContent = "COPIED // " + current.size.split(" ")[0];
        btn.classList.add("text-[#FFE700]");

        setTimeout(() => {
          icon.textContent = "content_copy";
          label.textContent = "copy";
          btn.classList.remove("text-[#FFE700]");
        }, 2000);
      }
    });
  }

  setInterval(() => {
    const heartbeats = [120, 240, 480, 890, 1840, 2100];
    const randHeartbeat = heartbeats[Math.floor(Math.random() * heartbeats.length)];
    const hbEl = document.querySelector("#ndjson-trace div:nth-child(4) span:nth-child(2)");
    if (hbEl) {
      hbEl.textContent = randHeartbeat;
    }
  }, 4500);
</script>
