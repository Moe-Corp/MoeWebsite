---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="MoeLog — Infrastructure Observability">
  <Header />
  <main class="w-full pt-24 bg-surface">
    <div class="max-w-7xl mx-auto px-gutter-desktop py-space-xl">
      <div class="flex flex-col w-full text-[#2D2A29]">
        <!-- SVG Patterns (Kasen & Genko Yoshi Grids) -->
        <svg class="hidden">
          <defs>
            <pattern height="8" id="speed-lines-pat" patternUnits="userSpaceOnUse" width="40">
              <line stroke="#2D2A29" stroke-opacity="0.05" stroke-width="1" x1="0" x2="40" y1="4" y2="4"></line>
            </pattern>
            <pattern height="6" id="speed-lines-dense" patternUnits="userSpaceOnUse" width="32">
              <line stroke="#2D2A29" stroke-opacity="0.12" stroke-width="1" x1="0" x2="32" y1="3" y2="3"></line>
            </pattern>
            <pattern height="24" id="genko-yoshi" patternUnits="userSpaceOnUse" width="24">
              <rect fill="none" height="24" stroke="#2D2A29" stroke-opacity="0.03" stroke-width="1" width="24"></rect>
              <line stroke="#2D2A29" stroke-dasharray="2,2" stroke-opacity="0.03" stroke-width="0.5" x1="12" x2="12" y1="0" y2="24"></line>
              <line stroke="#2D2A29" stroke-dasharray="2,2" stroke-opacity="0.03" stroke-width="0.5" x1="0" x2="24" y1="12" y2="12"></line>
            </pattern>
          </defs>
        </svg>

        <!-- 2. HERO SECTION -->
        <section class="relative w-full pb-16 pt-4 border-b border-[#BFBFC0]">
          <div class="absolute inset-0 pointer-events-none kinetic-speed-lines" style="background-image: repeating-linear-gradient(90deg, rgba(45,42,41,0.04) 0px, rgba(45,42,41,0.04) 20px, transparent 20px, transparent 40px); background-size: 40px 100%;"></div>
          <div class="relative grid grid-cols-12 gap-6 items-start">
            <!-- Left Column (7 cols) -->
            <div class="col-span-12 lg:col-span-7 flex flex-col space-y-6">
              <div class="flex items-center gap-2">
                <span class="font-label-md text-label-md tracking-[0.12em] text-[#8B8C8C] uppercase">死活監視 · LIVENESS MONITORING</span>
                <span class="relative inline-block w-12 h-px bg-[#BFBFC0] overflow-hidden">
                  <span class="absolute inset-0 bg-[#FFE700] w-4" style="animation: flow-line 2s linear infinite;"></span>
                </span>
              </div>
              <h1 class="font-headline-xl text-[44px] lg:text-[56px] leading-[1.05] tracking-tight text-[#2D2A29] font-bold">
                Observability that outlives the process it watches.
              </h1>
              <p class="font-body-lg text-body-lg text-[#2D2A29] max-w-[52ch] leading-relaxed">
                A 1.5 kB core, zero runtime dependencies, and a sidecar that runs outside your application — so a SIGKILL, a kernel OOM or a blocked event loop still gets reported. Self-host the whole stack on a free tier.
              </p>
              <!-- Code Box -->
              <div class="rounded-[2px] bg-[#2D2A29] border border-[#2D2A29] p-4 text-[#FFFFFF] flex flex-col gap-3">
                <div class="flex items-center justify-between border-b border-white/10 pb-2">
                  <div class="flex items-center gap-4 font-label-md text-label-md text-[#8B8C8C]" id="install-runtime-tabs">
                    <button class="text-[#FFE700] border-b-2 border-[#FFE700] pb-1 font-bold" onclick="selectRuntime('node', this)" type="button">node</button>
                    <button class="hover:text-white pb-1" onclick="selectRuntime('bun', this)" type="button">bun</button>
                    <button class="hover:text-white pb-1" onclick="selectRuntime('deno', this)" type="button">deno</button>
                    <button class="hover:text-white pb-1" onclick="selectRuntime('browser', this)" type="button">browser</button>
                    <button class="hover:text-white pb-1" onclick="selectRuntime('edge', this)" type="button">edge</button>
                  </div>
                  <button class="font-code-md text-code-md text-[#8B8C8C] hover:text-[#FFE700] flex items-center gap-1 transition-all active:scale-95 py-0.5 px-1.5 rounded" id="copy-btn" onclick="copyInstallCmd()" type="button">
                    <span class="material-symbols-outlined text-[14px]" id="copy-icon">content_copy</span>
                    <span id="copy-label">copy</span>
                  </button>
                </div>
                <div class="font-code-md text-code-md tracking-tight overflow-x-auto text-[#FFFFFF] py-1 flex items-center justify-between">
                  <span id="install-command"><span class="text-[#FFE700]">$</span> npm i @moecorp/moelog-node @moecorp/moelog-sidecar</span>
                  <span class="font-label-sm text-[10px] text-[#8B8C8C] shrink-0 ml-2">0.95 kB core</span>
                </div>
              </div>
              <!-- Buttons -->
              <div class="flex flex-wrap items-center gap-4 pt-2">
                <a class="px-6 py-3 bg-[#FFE700] text-[#2D2A29] font-headline-sm text-headline-sm font-medium rounded-[4px] border border-[#2D2A29] hover:bg-[#F5D80D] active:translate-x-px active:translate-y-px transition-all flex items-center gap-2 group" href="/docs">
                  <span>Start in five minutes</span>
                  <span class="material-symbols-outlined text-[16px] transition-transform group-hover:translate-x-0.5">arrow_forward</span>
                </a>
                <a class="px-6 py-3 bg-transparent text-[#2D2A29] font-headline-sm text-headline-sm font-medium rounded-[4px] border border-[#2D2A29] hover:bg-[#2D2A29]/5 active:translate-x-px active:translate-y-px transition-all" href="https://github.com/Moe-Corp/MoeLog.js" rel="noreferrer" target="_blank">
                  View on GitHub
                </a>
              </div>
            </div>
            <!-- Right Column (5 cols) -->
            <div class="col-span-12 lg:col-span-5 flex flex-col pt-2">
              <div class="bg-[#2D2A29] border border-[#BFBFC0] rounded-[2px] overflow-hidden shadow-sm">
                <div class="h-9 px-3 bg-[#2D2A29] border-b border-white/10 flex items-center justify-between text-[#8B8C8C]">
                  <div class="flex items-center gap-2">
                    <span class="inline-block w-2 h-2 rounded-full bg-[#FFE700] anim-live-dot"></span>
                    <span class="font-label-md text-label-md text-[#FFE700]" id="terminal-badge">sidecar · alert emitted 00:41:07</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="font-label-sm text-[9px] text-[#A4CF58] uppercase px-1 border border-[#A4CF58]/40 rounded-[2px]">LIVE</span>
                    <span class="font-label-sm text-label-sm text-[#8B8C8C]">UNIX_SOCKET</span>
                  </div>
                </div>
                <div class="p-4 font-code-md text-[13px] leading-relaxed text-[#FFFFFF] overflow-x-auto font-mono min-h-[160px] flex flex-col justify-between" id="terminal-log-content">
                  <div id="ndjson-trace">
                    <div>{"{"}<span class="text-[#187384]">"type"</span>:<span class="text-[#FFE700]">"app.crashed"</span>,<span class="text-[#187384]">"app"</span>:<span class="text-[#cbc5c3]">"checkout-api"</span>,</div>
                    <div class="pl-2"><span class="text-[#187384]">"runtime"</span>:<span class="text-[#cbc5c3]">"node@22.3.0"</span>,<span class="text-[#187384]">"release"</span>:<span class="text-[#cbc5c3]">"1.4.2"</span>,</div>
                    <div class="pl-2"><span class="text-[#187384]">"pid"</span>:<span class="text-[#cbc5c3]">48211</span>,<span class="text-[#187384]">"signal"</span>:<span class="text-[#FFE700]">"SIGKILL"</span>,</div>
                    <div class="pl-2"><span class="text-[#187384]">"last_heartbeat_ms_ago"</span>:<span class="text-[#cbc5c3]">1840</span>,</div>
                    <div class="pl-2"><span class="text-[#187384]">"fingerprint"</span>:<span class="text-[#187384]">"a7f3c901"</span>{"}"}</div>
                  </div>
                  <div class="pt-2 text-xs text-[#8B8C8C] flex items-center justify-between border-t border-white/5 mt-2">
                    <span class="flex items-center gap-1.5"><span class="text-[#FFE700]">›</span> <span id="terminal-stream-msg">stream reading /var/run/moelog.sock</span><span class="anim-terminal-cursor"></span></span>
                    <button class="text-[10px] text-[#FFE700]/70 hover:text-[#FFE700] underline" onclick="cycleTraceLog()" type="button">trigger signal</button>
                  </div>
                </div>
              </div>
              <p class="font-body-md text-body-md text-[#8B8C8C] mt-3">The process that wrote this was not the process that died.</p>
            </div>
          </div>
        </section>

        <!-- 3. PROOF STRIP -->
        <section class="w-full bg-[#2D2A29]/[0.03] border-b border-[#BFBFC0]">
          <div class="grid grid-cols-2 md:grid-cols-5 min-h-[64px] divide-y md:divide-y-0 md:divide-x divide-[#BFBFC0] items-center text-center">
            <div class="py-3 px-2 font-code-md text-code-md text-[#2D2A29] font-medium tracking-tight">0 runtime dependencies</div>
            <div class="py-3 px-2 font-code-md text-code-md text-[#2D2A29] font-medium tracking-tight">1.5 kB core, gzip</div>
            <div class="py-3 px-2 font-code-md text-code-md text-[#2D2A29] font-medium tracking-tight">4 packages on npm</div>
            <div class="py-3 px-2 font-code-md text-code-md text-[#2D2A29] font-medium tracking-tight">AGPL-3.0</div>
            <div class="py-3 px-2 col-span-2 md:col-span-1 font-code-md text-code-md text-[#2D2A29] font-medium tracking-tight">Node · Bun · Deno · Browser · Edge</div>
          </div>
        </section>

        <!-- 4. THE THREE BLIND SPOTS -->
        <section class="w-full py-16 border-b border-[#BFBFC0]">
          <div class="flex flex-col space-y-3 mb-10">
            <span class="font-label-md text-label-md tracking-[0.12em] text-[#8B8C8C] uppercase">THE ARGUMENT</span>
            <h2 class="font-headline-lg text-[32px] text-[#2D2A29] font-bold tracking-tight">Three things an in-process SDK can never tell you.</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
            <div class="flex flex-col p-4 rounded-[2px] technical-card-hover border border-transparent">
              <div class="w-full h-1 bg-[#FFE700] mb-4"></div>
              <div class="font-headline-xl text-[40px] leading-none text-[#BFBFC0] font-bold mb-3">01</div>
              <h3 class="font-headline-md text-headline-md text-[#2D2A29] font-bold mb-2">SIGKILL and kernel OOM</h3>
              <p class="font-body-md text-body-md text-[#2D2A29]/80 leading-relaxed">The kernel killed the process without warning. To report that, your SDK would have to still be running. It isn't.</p>
            </div>
            <div class="flex flex-col p-4 rounded-[2px] technical-card-hover border border-transparent">
              <div class="w-full h-1 bg-[#FFE700] mb-4"></div>
              <div class="font-headline-xl text-[40px] leading-none text-[#BFBFC0] font-bold mb-3">02</div>
              <h3 class="font-headline-md text-headline-md text-[#2D2A29] font-bold mb-2">A blocked event loop</h3>
              <p class="font-body-md text-body-md text-[#2D2A29]/80 leading-relaxed">To report that the loop is blocked, you would need the very loop that is blocked. The app is alive and answering nothing.</p>
            </div>
            <div class="flex flex-col p-4 rounded-[2px] technical-card-hover border border-transparent">
              <div class="w-full h-1 bg-[#FFE700] mb-4"></div>
              <div class="font-headline-xl text-[40px] leading-none text-[#BFBFC0] font-bold mb-3">03</div>
              <h3 class="font-headline-md text-headline-md text-[#2D2A29] font-bold mb-2">A process that never started</h3>
              <p class="font-body-md text-body-md text-[#2D2A29]/80 leading-relaxed">It failed before your instrumentation ever ran. There was nobody there to catch it.</p>
            </div>
          </div>
          <div class="text-center pt-4">
            <p class="font-body-lg text-[20px] text-[#2D2A29]">
              MoeLog reports all three, <span class="border-b-4 border-[#FFE700] pb-0.5 font-medium">because the reporter does not live inside your app.</span>
            </p>
          </div>
        </section>

        <!-- 5. HOW IT WORKS (Full Bleed Ink Section with Kinetic SVG Flow) -->
        <section class="-mx-gutter-desktop px-gutter-desktop py-20 bg-[#2D2A29] text-[#FFFFFF]">
          <div class="relative max-w-7xl mx-auto flex flex-col">
            <div class="hidden xl:flex absolute -left-12 top-0 flex-col items-center">
              <span class="font-bold text-sm tracking-widest text-[#8B8C8C]" style="writing-mode: vertical-rl;">番犬</span>
              <span class="font-label-sm text-[10px] text-[#8B8C8C] mt-2 uppercase tracking-widest">banken</span>
            </div>
            <div class="flex flex-col space-y-2 mb-12">
              <span class="font-label-md text-label-md text-[#8B8C8C] tracking-[0.12em] uppercase">番犬 · WATCHDOG</span>
              <h2 class="font-headline-lg text-[32px] text-white font-bold tracking-tight">Your app writes to a socket and forgets about it.</h2>
            </div>
            <div class="w-full overflow-x-auto pb-4">
              <div class="min-w-[860px] flex items-center justify-between py-6">
                <div class="border border-[#8B8C8C] p-3 px-4 rounded-[2px] bg-[#2D2A29] text-center technical-card-hover">
                  <span class="font-headline-sm text-headline-sm text-white">Your app</span>
                </div>
                <div class="flex-1 flex flex-col items-center px-2">
                  <span class="font-code-md text-[10px] text-[#8B8C8C] mb-1">unix socket · NDJSON</span>
                  <div class="w-full flex items-center">
                    <svg class="w-full h-4" preserveAspectRatio="none" viewBox="0 0 100 10">
                      <line class="pipeline-dash-flow" stroke="#FFE700" stroke-width="1.5" x1="0" x2="94" y1="5" y2="5"></line>
                      <polygon fill="#FFE700" points="94,2 100,5 94,8"></polygon>
                    </svg>
                  </div>
                </div>
                <div class="bg-[#FFE700] text-[#2D2A29] p-3 px-4 rounded-[2px] font-bold text-center border border-[#FFE700] shadow-[0_0_12px_rgba(255,231,0,0.25)]">
                  <span class="font-headline-sm text-headline-sm">Sidecar (detached process)</span>
                </div>
                <div class="flex-1 flex flex-col items-center px-2">
                  <span class="font-code-md text-[10px] text-[#8B8C8C] mb-1">HTTPS · compressed MLWP batch</span>
                  <div class="w-full flex items-center">
                    <svg class="w-full h-4" preserveAspectRatio="none" viewBox="0 0 100 10">
                      <line class="pipeline-dash-flow" stroke="#FFE700" stroke-width="1.5" x1="0" x2="94" y1="5" y2="5"></line>
                      <polygon fill="#FFE700" points="94,2 100,5 94,8"></polygon>
                    </svg>
                  </div>
                </div>
                <div class="border border-[#8B8C8C] p-3 px-4 rounded-[2px] bg-[#2D2A29] text-center technical-card-hover">
                  <span class="font-headline-sm text-headline-sm text-white">Ingest API</span>
                </div>
                <div class="w-8 flex items-center px-1">
                  <svg class="w-full h-4" viewBox="0 0 32 10">
                    <line class="pipeline-dash-flow" stroke="#8B8C8C" stroke-width="1.2" x1="0" x2="32" y1="5" y2="5"></line>
                  </svg>
                </div>
                <div class="border border-[#8B8C8C] p-3 px-4 rounded-[2px] bg-[#2D2A29] text-center technical-card-hover">
                  <span class="font-headline-sm text-headline-sm text-white">Postgres</span>
                </div>
                <div class="w-8 flex items-center px-1">
                  <svg class="w-full h-4" viewBox="0 0 32 10">
                    <line class="pipeline-dash-flow" stroke="#8B8C8C" stroke-width="1.2" x1="0" x2="32" y1="5" y2="5"></line>
                  </svg>
                </div>
                <div class="border border-[#8B8C8C] p-3 px-4 rounded-[2px] bg-[#2D2A29] text-center technical-card-hover">
                  <span class="font-headline-sm text-headline-sm text-white">Dashboard</span>
                </div>
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-10">
              <div class="border-t border-white/20 pt-4 flex flex-col space-y-2 technical-card-hover rounded-b-[2px] p-2">
                <h3 class="font-headline-sm text-headline-sm text-[#FFE700]">No network in your process.</h3>
                <p class="font-body-md text-body-md text-[#cbc5c3] leading-relaxed">The SDK validates, pushes to a pre-allocated ring buffer and returns. Serialising, compressing and sending happen somewhere else.</p>
              </div>
              <div class="border-t border-white/20 pt-4 flex flex-col space-y-2 technical-card-hover rounded-b-[2px] p-2">
                <h3 class="font-headline-sm text-headline-sm text-[#FFE700]">It survives the app.</h3>
                <p class="font-body-md text-body-md text-[#cbc5c3] leading-relaxed">Launched detached, it outlives the process it watches. It reads the crash markers off disk and classifies the death: fatal, crashed, exited_error, or a clean goodbye.</p>
              </div>
              <div class="border-t border-white/20 pt-4 flex flex-col space-y-2 technical-card-hover rounded-b-[2px] p-2">
                <h3 class="font-headline-sm text-headline-sm text-[#FFE700]">It fits in a free tier.</h3>
                <p class="font-body-md text-body-md text-[#cbc5c3] leading-relaxed">No Kafka. No ClickHouse. No four-container compose file. A Node process and a Postgres database.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- 6. ALERTS -->
        <section class="w-full py-16 border-b border-[#BFBFC0]">
          <div class="flex flex-col space-y-2 mb-8">
            <span class="font-label-md text-label-md tracking-[0.12em] text-[#8B8C8C] uppercase">障害 · INCIDENTS</span>
            <h2 class="font-headline-lg text-[32px] text-[#2D2A29] font-bold tracking-tight">Six ways a process dies, each with its own signal.</h2>
          </div>
          <div class="w-full overflow-x-auto border-t-2 border-[#2D2A29]">
            <table class="w-full text-left border-collapse min-w-[700px]">
              <thead>
                <tr class="border-b border-[#BFBFC0] bg-[#FFFFFF]">
                  <th class="py-3 px-4 font-label-md text-label-md text-[#8B8C8C] uppercase">TYPE</th>
                  <th class="py-3 px-4 font-label-md text-label-md text-[#8B8C8C] uppercase">WHAT HAPPENED</th>
                  <th class="py-3 px-4 font-label-md text-label-md text-[#8B8C8C] uppercase">SEVERITY</th>
                  <th class="py-3 px-4 font-label-md text-label-md text-[#8B8C8C] uppercase text-right">SOURCE</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#BFBFC0] font-body-md text-body-md">
                <tr class="table-row-hover hover:bg-[#FFE700]/[0.08] transition-colors h-12 cursor-pointer" onclick="setTerminalTrace('app.fatal', 'uncaught exception', 'SIGABRT', 241)">
                  <td class="py-2 px-4 font-code-md text-code-md text-[#2D2A29] font-bold">app.fatal</td>
                  <td class="py-2 px-4 text-[#2D2A29]">Uncaught exception. The app died of an error, and the full stack came with it</td>
                  <td class="py-2 px-4"><span class="inline-block px-2.5 py-0.5 rounded-full bg-[#2D2A29] text-[#FFE700] font-label-sm text-label-sm uppercase font-bold tracking-wider">severe</span></td>
                  <td class="py-2 px-4 font-code-md text-code-md text-[#8B8C8C] text-right">in-process</td>
                </tr>
                <tr class="table-row-hover hover:bg-[#FFE700]/[0.08] transition-colors h-12 cursor-pointer" onclick="setTerminalTrace('app.crashed', 'checkout-api', 'SIGKILL', 1840)">
                  <td class="py-2 px-4 font-code-md text-code-md text-[#2D2A29] font-bold">app.crashed</td>
                  <td class="py-2 px-4 text-[#2D2A29]">Abrupt death with no goodbye: SIGKILL, kernel OOM or a runtime panic</td>
                  <td class="py-2 px-4"><span class="inline-block px-2.5 py-0.5 rounded-full bg-[#2D2A29] text-[#FFE700] font-label-sm text-label-sm uppercase font-bold tracking-wider">severe</span></td>
                  <td class="py-2 px-4 font-code-md text-code-md text-[#8B8C8C] text-right">sidecar only</td>
                </tr>
                <tr class="table-row-hover hover:bg-[#FFE700]/[0.08] transition-colors h-12 cursor-pointer" onclick="setTerminalTrace('app.blocked', 'worker-queue', 'HEARTBEAT_TIMEOUT', 5120)">
                  <td class="py-2 px-4 font-code-md text-code-md text-[#2D2A29] font-bold">app.blocked</td>
                  <td class="py-2 px-4 text-[#2D2A29]">The heartbeat stopped. The app is still alive and is answering nothing</td>
                  <td class="py-2 px-4"><span class="inline-block px-2.5 py-0.5 rounded-full bg-[#F8951D] text-white font-label-sm text-label-sm uppercase font-bold tracking-wider">degraded</span></td>
                  <td class="py-2 px-4 font-code-md text-code-md text-[#8B8C8C] text-right">sidecar only</td>
                </tr>
                <tr class="table-row-hover hover:bg-[#FFE700]/[0.08] transition-colors h-12 cursor-pointer" onclick="setTerminalTrace('app.recovered', 'worker-queue', 'RESUMED', 320)">
                  <td class="py-2 px-4 font-code-md text-code-md text-[#2D2A29] font-bold">app.recovered</td>
                  <td class="py-2 px-4 text-[#2D2A29]">The heartbeat came back after a block</td>
                  <td class="py-2 px-4"><span class="inline-block px-2.5 py-0.5 rounded-full bg-[#A4CF58] text-[#2D2A29] font-label-sm text-label-sm uppercase font-bold tracking-wider">recovered</span></td>
                  <td class="py-2 px-4 font-code-md text-code-md text-[#8B8C8C] text-right">sidecar only</td>
                </tr>
                <tr class="table-row-hover hover:bg-[#FFE700]/[0.08] transition-colors h-12 cursor-pointer" onclick="setTerminalTrace('app.exited_error', 'billing-sync', 'EXIT_CODE_1', 940)">
                  <td class="py-2 px-4 font-code-md text-code-md text-[#2D2A29] font-bold">app.exited_error</td>
                  <td class="py-2 px-4 text-[#2D2A29]">Terminated with a non-zero exit code</td>
                  <td class="py-2 px-4"><span class="inline-block px-2.5 py-0.5 rounded-full bg-[#D69894] text-[#2D2A29] font-label-sm text-label-sm uppercase font-bold tracking-wider">error</span></td>
                  <td class="py-2 px-4 font-code-md text-code-md text-[#8B8C8C] text-right">sidecar</td>
                </tr>
                <tr class="table-row-hover hover:bg-[#FFE700]/[0.08] transition-colors h-12 cursor-pointer" onclick="setTerminalTrace('app.failed_to_start', 'ingest-proxy', 'SIGSEGV_EARLY', 0)">
                  <td class="py-2 px-4 font-code-md text-code-md text-[#2D2A29] font-bold">app.failed_to_start</td>
